      "name": "adf-diamond-clinical-91685bfa/DS_SourceAppointment",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', 'adf-diamond-clinical-91685bfa', 'LS_Diamond02')]"
      ],
      "properties": {
        "type": "AzureSqlTable",
        "linkedServiceName": {
          "type": "LinkedServiceReference",
          "referenceName": "LS_Diamond02"
        },
        "typeProperties": {
          "schema": "dbo",
          "table": "Appointment"
        },
        "schema": []
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/datasets",
