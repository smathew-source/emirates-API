meta {
  name: Order Create
  type: graphql
  seq: 3
}

post {
  url: {{apiBaseUrl}}
  body: graphql
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Referer: https://workbench.staging.llc.nuflights.com/
  authorization: {{ndcAuthorization}}
  x-nf-active-org-short-code: {{activeOrgShortCode}}
}

body:graphql {
  mutation ndcOrderCreateMutation($rq: OrderCreateRqInput!) {
    iataOrderCreate(rq: $rq) {
      augmentationPoint {
        common {
          nfOrderId
          nfSubscriptionId
        }
        provider {
          nfShoppingResponseId
        }
      }
      payloadAttributes {
        trxId
      }
      response {
        order {
          orderId
          ownerCode
          totalPrice {
            totalAmount {
              cdata
              curCode
            }
          }
        }
      }
      error {
        code
        typeCode
        descText
      }
    }
  }
}

