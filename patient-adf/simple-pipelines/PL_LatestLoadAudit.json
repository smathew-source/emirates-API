    "annotations": [
      "Read only",
      "Manual trigger"
    ],
    "activities": [
      {
        "name": "ReadLatestLoadAudit",
        "type": "Script",
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 0,
          "secureInput": false,
          "secureOutput": false
        },
        "linkedServiceName": {
