      "name": "adf-diamond-clinical-91685bfa/DS_StageAppointment",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/linkedservices', 'adf-diamond-clinical-91685bfa', 'LS_DiamondWarehouse')]"
      ],
      "properties": {
        "type": "AzureSqlTable",
        "linkedServiceName": {
          "type": "LinkedServiceReference",
