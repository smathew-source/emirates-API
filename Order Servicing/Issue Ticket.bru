meta {
  name: Issue Ticket
  type: graphql
  seq: 5
}

docs {
  This is the NDC ticket/payment commit call captured from the UI final Issue button.
  Run Order Retrieve Before Issue first so order item, amount, currency and trx id are populated.
}

post {
  url: {{apiBaseUrl}}
  body: graphql
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Referer: https://workbench.staging.llc.nuflights.com/
  authorization: {{ndcAuthorization}}
  x-nf-active-org-short-code: {{activeOrgShortCode}}
}

body:graphql {
  mutation ndcOrderChangePaymentMutation($rq: OrderChangeRqInput!) {
    iataOrderChange(rq: $rq) {
      error {
        descText
        code
        typeCode
        statusText
      }
      augmentationPoint {
        common {
          nfSubscriptionAirlineDesigCode
        }
        provider {
          nfShoppingResponseId
        }
      }
      payloadAttributes {
        trxId
      }
      response {
        order {
          orderId
          ownerCode
          totalPrice {
            totalAmount {
              cdata
              curCode
            }
          }
          orderItem {
            orderItemId
            service {
              serviceId
              paxRefId
              statusCode
            }
          }
        }
        ticketDocInfo {
          paxRefId
          referencedOrder {
            orderId
            ownerCode
          }
          originalIssueInfo {
            issueDate
            issueTime
            issuingCarrier {
              airlineDesigCode
            }
            ticketNumber
          }
          ticket {
            ticketDocTypeCode
            ticketNumber
            reportingTypeCode
            primaryDocInd
            coupon {
              couponNumber
              couponStatusCode
            }
          }
        }
      }
      paymentFunctions {
        orderAssociation {
          orderItemRefId
        }
        paymentProcessingSummary {
          paymentId
          amount {
            cdata
            curCode
          }
          paymentRefId
          paymentStatusCode
          verificationInd
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "rq": {
      "augmentationPoint": {
        "agency": {
          "paymentFunctions": [
            {
              "orderAssociation": {
                "orderItemRefId": [
                  "{{retrievedOrderItemId}}"
                ]
              },
              "paymentMethodCriteria": {
                "paymentTypeCode": "{{ticketingPaymentTypeCode}}",
                "customerCode": "{{customerPaymentCode}}"
              }
            }
          ]
        },
        "common": {
          "nfSubscriptionId": "{{createdNfSubscriptionId}}",
          "nfOrderId": "{{createdNfOrderId}}"
        },
        "paymentMetaData": {
          "usageAttributes": [
            {
              "attribKey": "trxSellerDiscount1",
              "attribValue": "0",
              "paxRefs": [
                "{{retrievedPaxRefId}}"
              ],
              "usages": [
                "OrderAdjustments"
              ]
            },
            {
              "attribKey": "trxSellerDiscount2",
              "attribValue": "0",
              "paxRefs": [
                "{{retrievedPaxRefId}}"
              ],
              "usages": [
                "OrderAdjustments"
              ]
            },
            {
              "attribKey": "trxSellerDiscount3",
              "attribValue": "0",
              "paxRefs": [
                "{{retrievedPaxRefId}}"
              ],
              "usages": [
                "OrderAdjustments"
              ]
            },
            {
              "attribKey": "trxSellerServiceFee1",
              "attribValue": "0",
              "paxRefs": [
                "{{retrievedPaxRefId}}"
              ],
              "usages": [
                "OrderAdjustments"
              ]
            },
            {
              "attribKey": "trxSellerServiceFee2",
              "attribValue": "0",
              "paxRefs": [
                "{{retrievedPaxRefId}}"
              ],
              "usages": [
                "OrderAdjustments"
              ]
            },
            {
              "attribKey": "trxSellerServiceFee3",
              "attribValue": "0",
              "paxRefs": [
                "{{retrievedPaxRefId}}"
              ],
              "usages": [
                "OrderAdjustments"
              ]
            }
          ]
        }
      },
      "distributionChain": {
        "distributionChainLink": [
          {
            "ordinal": 1,
            "orgRole": "SELLER",
            "participatingOrg": {
              "orgId": "{{servicingOrgId}}"
            }
          }
        ]
      },
      "payloadAttributes": {
        "trxId": "{{retrievedOrderTrxId}}"
      },
      "pos": {
        "country": {
          "countryCode": "{{servicingCountryCode}}"
        }
      },
      "request": {
        "order": {
          "orderId": "{{retrievedOrderId}}",
          "ownerCode": "{{retrievedOwnerCode}}"
        },
        "paymentFunctions": [
          {
            "paymentMethodCriteria": {
              "paymentTypeCode": "{{ticketingPaymentTypeCode}}"
            },
            "paymentProcessingDetails": {
              "amount": {
                "cdata": "{{retrievedTotalAmount}}",
                "curCode": "{{retrievedCurrency}}"
              },
              "paymentMethod": {
                "settlementPlan": {
                  "paymentTypeCode": "{{ticketingPaymentTypeCode}}"
                }
              }
            },
            "orderAssociation": {
              "orderItemRefId": [
                "{{retrievedOrderItemId}}"
              ],
              "orderRefId": "{{retrievedOrderId}}"
            }
          }
        ],
        "orderChangeParameters": {
          "pricingParameter": {
            "overrideCurCode": "{{retrievedCurrency}}"
          }
        }
      }
    }
  }
}

script:pre-request {
  const required = [
    "createdNfOrderId", "createdNfSubscriptionId", "retrievedOrderTrxId",
    "retrievedOrderId", "retrievedOwnerCode", "retrievedOrderItemId",
    "retrievedPaxRefId", "retrievedTotalAmount", "retrievedCurrency"
  ];
  const missing = required.filter(name => !(bru.getVar(name) || bru.getEnvVar(name)));
  if (missing.length) {
    throw new Error("Run a successful Order Retrieve Before Issue first; missing: " + missing.join(", "));
  }
}

script:post-response {
  const orderChange = res.body.data && res.body.data.iataOrderChange;

  if (orderChange && orderChange.response) {
    const ticketDocInfo = orderChange.response.ticketDocInfo;
    const firstTicketDoc = Array.isArray(ticketDocInfo) ? ticketDocInfo[0] : ticketDocInfo;
    const ticket = firstTicketDoc && firstTicketDoc.ticket
      ? Array.isArray(firstTicketDoc.ticket)
        ? firstTicketDoc.ticket[0]
        : firstTicketDoc.ticket
      : null;
    const issueInfo = firstTicketDoc && firstTicketDoc.originalIssueInfo;
    const ticketNumber = ticket && ticket.ticketNumber
      ? ticket.ticketNumber
      : issueInfo && issueInfo.ticketNumber;

    bru.setVar("ticketIssueTrxId", orderChange.payloadAttributes.trxId);
    bru.setEnvVar("ticketIssueTrxId", orderChange.payloadAttributes.trxId, { persist: true });

    if (ticketNumber) {
      bru.setVar("ticketNumber", ticketNumber);
      bru.setEnvVar("ticketNumber", ticketNumber, { persist: true });
    }

    bru.setVar("ticketedNfOrderId", bru.getVar("createdNfOrderId"));
    bru.setVar("ticketedNfSubscriptionId", bru.getVar("createdNfSubscriptionId"));
    bru.setVar("ticketedOrderId", bru.getVar("retrievedOrderId"));
    bru.setVar("ticketedOwnerCode", bru.getVar("retrievedOwnerCode"));
    bru.setVar("changeOrderItemId", bru.getVar("retrievedOrderItemId"));
    bru.setVar("changeServiceId", bru.getVar("retrievedServiceId"));
    bru.setVar("changeOrigin", bru.getVar("requestOrigin"));
    bru.setVar("changeDestination", bru.getVar("requestDestination"));
    const originalDepartureDate = bru.getVar("requestDepartureDate");
    const changeDepartureDate = bru.getVar("changeDepartureDate");

    bru.setVar("originalDepartureDate", originalDepartureDate);
    bru.setVar("changeDepartureDate", changeDepartureDate);
    bru.setVar("changeCabinTypeCode", bru.getVar("requestCabinTypeCode"));
    bru.setVar("changePassengerId", "T1");
    bru.setVar("changePassengerType", "ADT");
    bru.setVar("changeCurrency", bru.getVar("retrievedCurrency"));

    bru.setEnvVar("ticketedNfOrderId", bru.getVar("createdNfOrderId"), { persist: true });
    bru.setEnvVar("ticketedNfSubscriptionId", bru.getVar("createdNfSubscriptionId"), { persist: true });
    bru.setEnvVar("ticketedOrderId", bru.getVar("retrievedOrderId"), { persist: true });
    bru.setEnvVar("ticketedOwnerCode", bru.getVar("retrievedOwnerCode"), { persist: true });
    bru.setEnvVar("changeOrderItemId", bru.getVar("retrievedOrderItemId"), { persist: true });
    bru.setEnvVar("changeServiceId", bru.getVar("retrievedServiceId"), { persist: true });
    bru.setEnvVar("changeOrigin", bru.getVar("requestOrigin"), { persist: true });
    bru.setEnvVar("changeDestination", bru.getVar("requestDestination"), { persist: true });
    bru.setEnvVar("originalDepartureDate", originalDepartureDate, { persist: true });
    bru.setEnvVar("changeDepartureDate", changeDepartureDate, { persist: true });
    bru.setEnvVar("changeCabinTypeCode", bru.getVar("requestCabinTypeCode"), { persist: true });
    bru.setEnvVar("changePassengerId", "T1", { persist: true });
    bru.setEnvVar("changePassengerType", "ADT", { persist: true });
    bru.setEnvVar("changeCurrency", bru.getVar("retrievedCurrency"), { persist: true });
  }
}

tests {
  test("IssueTicket succeeds", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errors).to.be.undefined;
  });

  test("returns ticket document", function () {
    const orderChange = res.body.data.iataOrderChange;
    const errors = orderChange.error || [];
    expect(errors.length).to.equal(0);
    expect(orderChange.response.ticketDocInfo).to.exist;
  });

  test("IssueTicket has no business errors", function () {
    const orderChange = res.body.data.iataOrderChange;
    const errors = orderChange.error || [];

    expect(errors).to.be.an("array").that.is.empty;
  });

  test("issued Emirates ticket contains a ticket number and coupon", function () {
    const orderChange = res.body.data.iataOrderChange;
    const rawDocInfo = orderChange.response.ticketDocInfo;
    const docInfo = Array.isArray(rawDocInfo) ? rawDocInfo[0] : rawDocInfo;
    const rawTickets = docInfo.ticket;
    const tickets = Array.isArray(rawTickets) ? rawTickets : [rawTickets];
    const ticket = tickets[0];
    const rawCoupons = ticket.coupon;
    const coupons = Array.isArray(rawCoupons) ? rawCoupons : [rawCoupons];
    const ticketNumber = ticket.ticketNumber ||
      (docInfo.originalIssueInfo && docInfo.originalIssueInfo.ticketNumber);

    expect(ticketNumber).to.be.a("string").and.not.empty;
    expect(ticket.ticketDocTypeCode).to.be.a("string").and.not.empty;
    expect(coupons).to.be.an("array").that.is.not.empty;
    expect(coupons[0].couponNumber).to.exist;
    expect(coupons[0].couponStatusCode).to.be.a("string").and.not.empty;
  });

  test("issued Emirates ticket contains order and passenger associations", function () {
    const orderChange = res.body.data.iataOrderChange;
    const rawOrders = orderChange.response.order;
    const orders = Array.isArray(rawOrders) ? rawOrders : [rawOrders];
    const order = orders[0];
    const rawDocInfo = orderChange.response.ticketDocInfo;
    const docInfo = Array.isArray(rawDocInfo) ? rawDocInfo[0] : rawDocInfo;
    const expectedOrderId = bru.getVar("retrievedOrderId") || bru.getEnvVar("retrievedOrderId");
    const expectedOwnerCode = bru.getVar("retrievedOwnerCode") || bru.getEnvVar("retrievedOwnerCode");

    expect(orders).to.be.an("array").that.is.not.empty;
    expect(order).to.be.an("object");
    const paxRefIds = Array.isArray(docInfo.paxRefId)
      ? docInfo.paxRefId
      : docInfo.paxRefId
        ? [docInfo.paxRefId]
        : [];
    expect(paxRefIds).to.be.an("array").that.is.not.empty;

    // Emirates may omit identifiers from both response.order and
    // ticketDocInfo.referencedOrder during ticket issuance. Validate them when
    // present and rely on the ticket/passenger association otherwise.
    if (order.orderId) {
      expect(order.orderId).to.equal(expectedOrderId);
    }
    if (order.ownerCode) {
      expect(order.ownerCode).to.equal(expectedOwnerCode);
    }
    if (docInfo.referencedOrder && docInfo.referencedOrder.orderId) {
      expect(docInfo.referencedOrder.orderId).to.equal(order.orderId);
    }
    if (docInfo.referencedOrder && docInfo.referencedOrder.ownerCode) {
      expect(docInfo.referencedOrder.ownerCode).to.equal(order.ownerCode);
    }
  });

  test("Emirates ticket payment is recorded", function () {
    const orderChange = res.body.data.iataOrderChange;
    const rawPayments = orderChange.paymentFunctions;
    const payments = Array.isArray(rawPayments) ? rawPayments : [rawPayments];
    const payment = payments[0];
    const summary = payment.paymentProcessingSummary;
    const amount = summary.amount;

    expect(payments).to.be.an("array").that.is.not.empty;
    expect(summary.paymentId).to.be.a("string").and.not.empty;
    expect(summary.paymentStatusCode).to.be.a("string").and.not.empty;
    expect(amount.cdata).to.exist;
    expect(amount.curCode).to.equal(bru.getVar("retrievedCurrency") || bru.getEnvVar("retrievedCurrency"));
  });
}
