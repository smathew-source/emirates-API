          "referenceName": "LS_DiamondWarehouse"
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": "EXEC etl.GetLatestLoadAudit;"
            }
          ],
          "scriptBlockExecutionTimeout": "00:02:00"
        }
      }
    ]
  }
}
